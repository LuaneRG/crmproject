# se usa componentes como tags, js é feito abrindo chaves

# props são dados ou argumentos passados de um componente pai para um componente filho, se passa tipo um atributo
# na tag do componente
# componentes sao com letra maiuscula
# desestruture o props, props passa a ser {nome pra passar os dados}

#no react nao se pode ter 2 elementos pais, um só

"use client";

//importar o css? import ./globals.css?

import { useState } from "react";

export default function Home() {
    const [clients/*consultar, esse tambem é o nome da variavel*/, setClients/*colocar*/] = useState([
        //array de objetos
    ]);

    return (
        <div className="app">
            <h1>Lista de Clientes</h1>
            <div className="client-list">
                {clients.map((client) => ( /*aqui é com parenteses, nao com chaves*/
                    <Clients /*propriedade(props)*/ client= /*valor pra passar, como é um map, é item por item*/{client} />
                ))}
            </div>
        </div>
    );
}




